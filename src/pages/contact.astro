---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, WEB3FORMS_ACCESS_KEY_CONTACT } from '../data/site.js';

// Google Maps embeds, pinned to the exact Place ID for each office address (no API key needed for embed).
const offices = [
  {
    flag: '🇦🇺',
    city: 'Sunshine Coast',
    tag: 'Headquarters',
    address: `${SITE.address.street}, ${SITE.address.suburb} ${SITE.address.state} ${SITE.address.postcode}, Australia`,
    mapHref: 'https://maps.google.com/?q=10+Thomas+St+Noosaville+QLD+4566+Australia',
    embedSrc:
      'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d14295.035009256504!2d153.0621833227274!3d-26.39898062966298!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6b93691df219c6b7%3A0xbe0f2feaa550ba03!2s10%20Thomas%20St%2C%20Noosaville%20QLD%204566%2C%20Australia!5e0!3m2!1sen!2sid!4v1784272732527!5m2!1sen!2sid',
    mapAlt: 'Map showing the Indi office in Noosaville, Sunshine Coast',
  },
  {
    flag: '🇮🇩',
    city: 'Bali',
    tag: null,
    address: SITE.addressBali,
    mapHref: 'https://maps.google.com/?q=Jl.+Kayu+Aya+No.10+Seminyak+Kuta+Badung+Bali+Indonesia',
    embedSrc:
      'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3944.063329658216!2d115.15466550000001!3d-8.6855279!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2dd2471abdc967cd%3A0x17f399c8accf0f14!2sJl.%20Kayu%20Aya%20No.10%2C%20Seminyak%2C%20Kec.%20Kuta%2C%20Kabupaten%20Badung%2C%20Bali!5e0!3m2!1sen!2sid!4v1784272761312!5m2!1sen!2sid',
    mapAlt: 'Map showing the Indi office in Seminyak, Bali',
  },
];
---

<BaseLayout
  title="Contact Indi"
  description="Get in touch with Indi, the commercial team behind independent hotels and motels in Australia."
  path="/contact"
>
  <section class="bg-[var(--color-sand-1)]">
    <div class="w-full max-w-full md:max-w-2xl lg:max-w-4xl xl:max-w-7xl mx-auto px-6 sm:px-0 pt-28 pb-24 md:pt-36 md:pb-32">
      <span class="eyebrow block mb-4" data-aos="fade-up">Contact</span>
      <h1 class="display text-[clamp(32px,5.6vw,56px)] max-w-[18ch]" data-aos="fade-up">
        Let's talk about your property.
      </h1>
      <p class="subhead text-[clamp(19px,2.4vw,24px)] text-[var(--color-grey)] max-w-[46ch] mt-7" data-aos="fade-up" data-aos-delay="80">
        Whether you have a specific question or you're ready to explore what's possible, we'd love to hear from you. We reply to every message personally.
      </p>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="w-full max-w-full md:max-w-2xl lg:max-w-4xl xl:max-w-7xl mx-auto px-6 sm:px-0 grid gap-12 lg:grid-cols-[1.1fr_0.9fr] items-start">
      <!-- Form -->
      <div class="card p-7 md:p-9" data-aos="fade-up">
        <h2 class="display text-[26px]">Send us a message.</h2>
        <p class="text-[15px] text-[var(--color-grey)] mt-1.5 mb-7 leading-relaxed">
          Tell us a little about your property and what you're after. We'll come back to you within one business day.
        </p>

        <form class="space-y-4" action="https://api.web3forms.com/submit" method="post" data-ajax-form>
          <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY_CONTACT} />
          <input type="hidden" name="subject" value="New contact form message — Indi" />
          <input type="hidden" name="from_name" value="Indi website" />
          <input type="hidden" name="redirect" value={`${SITE.url}/contact`} />
          <input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" autocomplete="off" />
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="name" class="block text-[13px] font-semibold mb-1.5">Your name</label>
              <input type="text" id="name" name="name" placeholder="Jane Smith" required
                class="w-full text-[15px] text-[var(--color-ink)] bg-[var(--color-white)] border border-[var(--color-sand-line)] rounded-[10px] px-3.5 py-3 outline-none transition-colors focus:border-[var(--color-azure)]" />
            </div>
            <div>
              <label for="property" class="block text-[13px] font-semibold mb-1.5">Property name</label>
              <input type="text" id="property" name="property" placeholder="The Harbour Motel" required
                class="w-full text-[15px] text-[var(--color-ink)] bg-[var(--color-white)] border border-[var(--color-sand-line)] rounded-[10px] px-3.5 py-3 outline-none transition-colors focus:border-[var(--color-azure)]" />
            </div>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="email" class="block text-[13px] font-semibold mb-1.5">Email</label>
              <input type="email" id="email" name="email" placeholder="jane@harbourmotel.com.au" required
                class="w-full text-[15px] text-[var(--color-ink)] bg-[var(--color-white)] border border-[var(--color-sand-line)] rounded-[10px] px-3.5 py-3 outline-none transition-colors focus:border-[var(--color-azure)]" />
            </div>
            <div>
              <label for="phone" class="block text-[13px] font-semibold mb-1.5">Phone <span class="text-[var(--color-grey)] font-normal">(optional)</span></label>
              <input type="tel" id="phone" name="phone" placeholder="0400 000 000"
                class="w-full text-[15px] text-[var(--color-ink)] bg-[var(--color-white)] border border-[var(--color-sand-line)] rounded-[10px] px-3.5 py-3 outline-none transition-colors focus:border-[var(--color-azure)]" />
            </div>
          </div>
          <div>
            <label for="message" class="block text-[13px] font-semibold mb-1.5">Message</label>
            <textarea id="message" name="message" placeholder="What can we help with?" required rows="5"
              class="w-full text-[15px] text-[var(--color-ink)] bg-[var(--color-white)] border border-[var(--color-sand-line)] rounded-[10px] px-3.5 py-3 outline-none transition-colors focus:border-[var(--color-azure)] min-h-[120px] resize-y"></textarea>
          </div>
          <button type="submit" class="btn btn-azure">Send message</button>
          <p class="text-[12.5px] text-[var(--color-grey)]">We'll only use your details to reply to your message.</p>
          <p data-form-status class="form-status text-[13.5px] font-semibold" role="status" aria-live="polite"></p>
        </form>

        <div class="mt-7 pt-6 border-t border-[var(--color-line)] text-[14.5px] text-[var(--color-grey)]">
          Prefer a proper look at your commercials?
          <a href="/free-discovery" class="text-[var(--color-azure)] font-semibold">Start your free discovery →</a>
        </div>
      </div>

      <!-- RIGHT RAIL -->
      <div class="space-y-4" data-aos="fade-up" data-aos-delay="80">
        <div class="card p-6 md:p-7">
          <p class="text-[12px] font-bold tracking-wide text-[var(--color-grey)] mb-4">GET IN TOUCH</p>
          <div class="flex items-center gap-3 mb-4">
            <span class="w-10 h-10 rounded-[10px] flex items-center justify-center shrink-0" style="background:var(--color-sky)">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-azure)" stroke-width="1.7" class="shrink-0"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
            </span>
            <div>
              <p class="text-[12px] text-[var(--color-grey)]">Email</p>
              <a href={`mailto:${SITE.email}`} class="text-[15px] text-[var(--color-ink)] font-semibold hover:text-[var(--color-azure)] transition-colors">{SITE.email}</a>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <span class="w-10 h-10 rounded-[10px] flex items-center justify-center shrink-0" style="background:var(--color-sky)">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-azure)" stroke-width="1.7" class="shrink-0"><path d="M5 4h4l2 5-3 2a12 12 0 006 6l2-3 5 2v4a2 2 0 01-2 2A17 17 0 013 6a2 2 0 012-2z"/></svg>
            </span>
            <div>
              <p class="text-[12px] text-[var(--color-grey)]">Phone</p>
              <a href={`tel:${SITE.phone.replace(/\s+/g, '')}`} class="text-[15px] text-[var(--color-ink)] font-semibold hover:text-[var(--color-azure)] transition-colors">{SITE.phone}</a>
            </div>
          </div>
        </div>

        <!-- OFFICES FEATURE -->
        <div class="rounded-2xl p-6 md:p-7 text-[var(--color-paper)]" style="background:var(--color-ink)">
          <p class="text-[12px] font-semibold tracking-wide mb-1" style="color:#7FB0FF">Two offices</p>
          <h3 class="display text-[22px] mb-5">On the ground, around the clock.</h3>

          {offices.map((o, i) => (
            <div class:list={['py-4', i > 0 && 'border-t border-[#232833]']}>
              <div class="flex items-start gap-3">
                <span class="text-[24px] leading-none">{o.flag}</span>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="text-[15px] font-semibold">{o.city}</span>
                    {o.tag && (
                      <span class="text-[10.5px] font-semibold rounded-full px-2 py-0.5" style="color:#0E1116;background:#7FB0FF">{o.tag}</span>
                    )}
                  </div>
                  <p class="text-[13px] mt-1 leading-relaxed" style="color:#AEB5BF">{o.address}</p>
                  <div class="relative mt-3">
                    <iframe
                      src={o.embedSrc}
                      title={o.mapAlt}
                      loading="lazy"
                      tabindex="-1"
                      class="w-full h-[180px] rounded-[10px] border pointer-events-none"
                      style="border-color:#2A303B;filter:grayscale(55%) contrast(95%)"
                    ></iframe>
                    <a href={o.mapHref} target="_blank" rel="noopener" aria-label={`Open ${o.city} office in Google Maps`} class="absolute inset-0 rounded-[10px]"></a>
                  </div>
                  <a href={o.mapHref} target="_blank" rel="noopener" class="inline-block text-[12px] font-semibold mt-2 transition-colors" style="color:#7FB0FF">Open in Maps →</a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
