---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE, WEB3FORMS_ACCESS_KEY_FREE_DISCOVERY } from '../data/site.js';

const what = [
  'A review of your current distribution and channel mix',
  'Where your pricing has the most room to move',
  'How your direct-booking and marketing setup stacks up',
  'A clear, recommended path, no cost, no commitment',
];
---

<BaseLayout
  title="Start your free commercial discovery"
  description="Start with a free commercial discovery of your independent hotel's distribution, revenue management and marketing. No cost, no commitment. Indi shows you where the upside is."
  path="/free-discovery"
>
  <section class="bg-[var(--color-sand-1)]">
    <div class="w-full max-w-full md:max-w-2xl lg:max-w-4xl xl:max-w-7xl mx-auto px-6 sm:px-0 pt-28 pb-24 md:pt-36 md:pb-32">
      <span class="eyebrow block mb-4" data-aos="fade-up">Commercial Discovery</span>
      <h1 class="display text-[clamp(32px,5.6vw,56px)] max-w-[18ch]" data-aos="fade-up">
        See your property through an expert's eyes.
      </h1>
      <p class="subhead text-[clamp(19px,2.4vw,24px)] text-[var(--color-grey)] max-w-[46ch] mt-7" data-aos="fade-up" data-aos-delay="80">
        Tell us about your property. We'll review your distribution, revenue and marketing, and show you the upside.
      </p>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="w-full max-w-full md:max-w-2xl lg:max-w-4xl xl:max-w-7xl mx-auto px-6 sm:px-0 grid gap-12 lg:grid-cols-[0.85fr_1.15fr] items-start">
      <!-- What you get -->
      <div data-aos="fade-up">
        <span class="eyebrow">What's in the discovery</span>
        <ul class="mt-6 space-y-4">
          {what.map((w) => (
            <li class="flex gap-3 items-start">
              <Icon name="check_circle" size={22} class="text-[var(--color-azure)] shrink-0 mt-0.5" fill={1} />
              <span class="text-[16px] text-[#3a3b3d] leading-relaxed">{w}</span>
            </li>
          ))}
        </ul>
        <div class="mt-8 rounded-xl bg-[var(--color-ash)] p-6 space-y-2">
          <p class="text-[14.5px] text-[#4a4b4d] leading-relaxed">
            Prefer email? Reach us at
            <a href={`mailto:${SITE.email}`} class="text-[var(--color-ink)] font-semibold underline decoration-[var(--color-line)] underline-offset-2">{SITE.email}</a>
            or call
            <a href={`tel:${SITE.phone.replace(/\s+/g, '')}`} class="text-[var(--color-ink)] font-semibold underline decoration-[var(--color-line)] underline-offset-2">{SITE.phone}</a>.
          </p>
          <p class="text-[13px] text-[var(--color-grey)] leading-relaxed">
            {SITE.address.street}, {SITE.address.suburb} {SITE.address.state} {SITE.address.postcode}, Australia
          </p>
        </div>
      </div>

      <!-- Form -->
      <div class="card p-7 md:p-9" data-aos="fade-up" data-aos-delay="80">
        <h2 class="display text-[26px]">Start your free discovery.</h2>
        <p class="text-[15px] text-[var(--color-grey)] mt-1.5 mb-7 leading-relaxed">
          Tell us a little about your property. We'll come back to you within one business day.
        </p>

        <form class="space-y-4" action="https://api.web3forms.com/submit" method="post" data-ajax-form>
          <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY_FREE_DISCOVERY} />
          <input type="hidden" name="subject" value="New free discovery request — Indi" />
          <input type="hidden" name="from_name" value="Indi website" />
          <input type="hidden" name="redirect" value={`${SITE.url}/free-discovery`} />
          <input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" autocomplete="off" />
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="name" class="block text-[13px] font-semibold mb-1.5">Your name</label>
              <input type="text" id="name" name="name" placeholder="Jane Smith" required
                class="w-full text-[15px] text-[var(--color-ink)] bg-[var(--color-white)] border border-[var(--color-sand-line)] rounded-[10px] px-3.5 py-3 outline-none transition-colors focus:border-[var(--color-azure)]" />
            </div>
            <div>
              <label for="property" class="block text-[13px] font-semibold mb-1.5">Property name</label>
              <input type="text" id="property" name="property" placeholder="The Harbour Motel" required
                class="w-full text-[15px] text-[var(--color-ink)] bg-[var(--color-white)] border border-[var(--color-sand-line)] rounded-[10px] px-3.5 py-3 outline-none transition-colors focus:border-[var(--color-azure)]" />
            </div>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="location" class="block text-[13px] font-semibold mb-1.5">Location</label>
              <input type="text" id="location" name="location" placeholder="Hobart, TAS" required
                class="w-full text-[15px] text-[var(--color-ink)] bg-[var(--color-white)] border border-[var(--color-sand-line)] rounded-[10px] px-3.5 py-3 outline-none transition-colors focus:border-[var(--color-azure)]" />
            </div>
            <div>
              <label for="rooms" class="block text-[13px] font-semibold mb-1.5">Approx. rooms</label>
              <select id="rooms" name="rooms" required
                class="w-full text-[15px] text-[var(--color-ink)] bg-[var(--color-white)] border border-[var(--color-sand-line)] rounded-[10px] px-3.5 py-3 outline-none transition-colors focus:border-[var(--color-azure)]">
                <option value="" disabled selected>Select a range</option>
                <option value="Under 20">Under 20</option>
                <option value="20 to 50">20 to 50</option>
                <option value="50 to 100">50 to 100</option>
                <option value="100+">100+</option>
              </select>
            </div>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="email" class="block text-[13px] font-semibold mb-1.5">Email</label>
              <input type="email" id="email" name="email" placeholder="jane@harbourmotel.com.au" required
                class="w-full text-[15px] text-[var(--color-ink)] bg-[var(--color-white)] border border-[var(--color-sand-line)] rounded-[10px] px-3.5 py-3 outline-none transition-colors focus:border-[var(--color-azure)]" />
            </div>
            <div>
              <label for="phone" class="block text-[13px] font-semibold mb-1.5">Phone <span class="text-[var(--color-grey)] font-normal">(optional)</span></label>
              <input type="tel" id="phone" name="phone" placeholder="0400 000 000"
                class="w-full text-[15px] text-[var(--color-ink)] bg-[var(--color-white)] border border-[var(--color-sand-line)] rounded-[10px] px-3.5 py-3 outline-none transition-colors focus:border-[var(--color-azure)]" />
            </div>
          </div>
          <div>
            <label for="message" class="block text-[13px] font-semibold mb-1.5">Tell us about your property</label>
            <textarea id="message" name="message" placeholder="What can we help with?" required rows="5"
              class="w-full text-[15px] text-[var(--color-ink)] bg-[var(--color-white)] border border-[var(--color-sand-line)] rounded-[10px] px-3.5 py-3 outline-none transition-colors focus:border-[var(--color-azure)] min-h-[120px] resize-y"></textarea>
          </div>
          <button type="submit" class="btn btn-azure">Start your free discovery</button>
          <p class="text-[12.5px] text-[var(--color-grey)]">We'll only use your details to reply to your message.</p>
          <p data-form-status class="form-status text-[13.5px] font-semibold" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
