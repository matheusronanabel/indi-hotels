---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';

const beliefs = [
  ['Independence is the point', 'We make your property stronger without making it less yours.'],
  ['Straight talk', "We tell you what's realistic for your property and market, not what sounds good."],
  ['The work is the value', "Strategy that's actually implemented, not a deck that sits in a drawer."],
];

const disciplines = [
  { icon: 'lan', title: 'Distribution', body: 'Every channel and OTA, connected cleanly and optimised.' },
  { icon: 'monitoring', title: 'Revenue management', body: 'Pricing and rate plans that move with demand.' },
  { icon: 'campaign', title: 'Digital marketing', body: 'Direct-booking campaigns that turn lookers into guests.' },
];

const team = [
  { name: 'Sonny', role: 'Revenue', photo: '/teams/sonny.jpg' },
  { name: 'Deby', role: 'Operations', photo: '/teams/deby.jpg' },
  { name: 'Abel', role: 'Developer', photo: '/teams/abel.jpg' },
  { name: 'Yudi', role: 'Revenue', photo: '/teams/yudi.jpg' },
  { name: 'Yuka', role: 'Administrator', photo: '/teams/yuka.jpg' },
];
---

<BaseLayout
  title="About: the commercial team behind independent hotels"
  description="Indi is the expert commercial team behind independent hotels and motels: distribution, revenue management and marketing, run by people who do this for a living. We serve independents. We don't own or brand them."
  path="/about"
>
  <PageHero
    eyebrow="About"
    heading="Independence, backed by real commercial expertise."
    sub="Indi is the expert commercial team behind independent hotels and motels: distribution, revenue management and marketing, run by people who do this for a living."
  />

  <!-- WHY INDI EXISTS -> HOW WE DELIVER IT (one narrative) -->
  <section class="py-20 md:py-28">
    <div class="w-full max-w-full md:max-w-2xl lg:max-w-4xl xl:max-w-7xl mx-auto px-6 sm:px-0 grid gap-12 lg:grid-cols-[1fr_1fr] items-start">
      <SectionHead
        human
        eyebrow="Why Indi"
        heading="Independent by design, backed by one expert team."
        note="Indi exists to give independent hotels the commercial firepower of a major group, without giving up what makes them independent: the autonomy to run your property your way, and the freedom to be genuinely yours. Lower costs, more direct bookings, and sophisticated strategies usually reserved for the big brands, delivered by a team who does this for a living. You bring the hospitality. We bring the commercial expertise behind it."
      />
      <div class="space-y-4" data-aos="fade-up">
        {disciplines.map((d) => (
          <div class="card p-6 flex items-start gap-4">
            <span class="w-11 h-11 rounded-full bg-[var(--color-sky)] flex items-center justify-center shrink-0">
              <Icon name={d.icon} size={20} class="text-[var(--color-azure)]" />
            </span>
            <div>
              <h3 class="font-semibold text-[17px]">{d.title}</h3>
              <p class="text-[15px] text-[var(--color-grey)] mt-1 leading-relaxed">{d.body}</p>
            </div>
          </div>
        ))}
        <p class="text-[15px] text-[var(--color-grey)] leading-relaxed pt-2">
          One team, coordinated under one roof, not a stack of consultants who don't talk to each other. We're not software you learn and run yourself. We're the people who run it for you, at the level of support you choose.
        </p>
      </div>
    </div>
  </section>

  <!-- WHAT WE BELIEVE -->
  <section class="py-20 md:py-28">
    <div class="w-full max-w-full md:max-w-2xl lg:max-w-4xl xl:max-w-7xl mx-auto px-6 sm:px-0">
      <SectionHead human eyebrow="What we believe" heading="Three things, held to." />
      <div class="grid gap-4 md:grid-cols-3 mt-12">
        {beliefs.map(([t, b], i) => (
          <div class="card p-7" data-aos="fade-up" data-aos-delay={i * 80}>
            <span class="font-semibold text-[13px] text-[var(--color-clay)]">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="display text-[22px] mt-3">{t}</h3>
            <p class="text-[15px] text-[var(--color-grey)] mt-2.5 leading-relaxed">{b}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TEAM (container) -->
  <section class="py-20 md:py-28 bg-[var(--color-sand)]">
    <div class="w-full max-w-full md:max-w-2xl lg:max-w-4xl xl:max-w-7xl mx-auto px-6 sm:px-0">
      <SectionHead human eyebrow="The team" heading="Real faces, real hotel experience." note="Founder-led, and every member of the team is dedicated to your property's commercial performance." />
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 mt-12">
        {team.map((t, i) => (
          <div class="card-human p-7" data-aos="fade-up" data-aos-delay={i * 80}>
            {t.photo ? (
              <img src={t.photo} alt={t.name} class="w-16 h-16 rounded-full object-cover border border-[var(--color-sand-line)]" />
            ) : (
              <span class="w-16 h-16 rounded-full bg-[var(--color-sand-line)] border border-[var(--color-sand-line)] flex items-center justify-center">
                <Icon name="person" size={30} class="text-[var(--color-clay)]" />
              </span>
            )}
            <h3 class="font-semibold text-[17px] mt-5">{t.name}</h3>
            <p class="text-[14.5px] text-[var(--color-grey)] mt-1.5 leading-relaxed">{t.role}</p>
          </div>
        ))}
      </div>
      <p class="text-[12px] text-[var(--color-grey)] mt-8" data-aos="fade-up">
        Based in Sunshine Coast, QLD, and Seminyak, Bali.
      </p>
    </div>
  </section>

  <!-- WHY OWNERS CHOOSE INDI -->
  <section class="py-20 md:py-28">
    <div class="w-full max-w-full md:max-w-2xl lg:max-w-4xl xl:max-w-7xl mx-auto px-6 sm:px-0">
      <SectionHead human eyebrow="Why owners choose Indi" heading="A partner whose only job is your commercial performance." />
      <p class="text-[18px] leading-relaxed tracking-[-0.01em] text-[#3a3b3d] mt-6 max-w-[64ch]" data-aos="fade-up">
        No guesswork on where you stand. It starts with a free discovery that shows you the upside before you commit a cent. One team for everything that drives your revenue. And a partner whose only job is your commercial performance, not selling you software, not putting you in a uniform.
      </p>
    </div>
  </section>

  <CtaBand
    heading="See what an expert commercial team could do for your property."
    sub="Have a question, or want to know more about how we work? Get in touch."
    ctaLabel="Get in touch"
    ctaHref="/contact"
  />
</BaseLayout>
